DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Discord calendar posting (Supabase Edge Function secrets) ────────────────
# Set with `supabase secrets set NAME=value`, NOT here. Listed for reference.
# None are VITE_-prefixed, so none can reach the browser bundle.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the platform.
# DISCORD_CRON_SECRET=                  # must match private.discord_calendar_config.hook_secret
# DISCORD_CALENDAR_MODE=report          # 'live' to actually post
# DISCORD_CALENDAR_CHANNEL=calendar
# DISCORD_ANNOUNCE_CHANNEL=announcements
# DISCORD_CALENDAR_HORIZON_DAYS=14

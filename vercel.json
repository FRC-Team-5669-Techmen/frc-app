{
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/connector/protected-resource?route=protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/connector/protected-resource?route=protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/connector/authorization-server?route=authorization-server"
    },
    {
      "source": "/connector/token",
      "destination": "/api/connector/token?route=token"
    },
    {
      "source": "/connector/register",
      "destination": "/api/connector/register?route=register"
    },
    {
      "source": "/connector/revoke",
      "destination": "/api/connector/revoke?route=revoke"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/discord-week-ahead",
      "schedule": "0 1 * * *"
    }
  ]
}

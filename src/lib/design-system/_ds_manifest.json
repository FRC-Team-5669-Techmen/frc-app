{
  "namespace": "FRC5669DesignSystem",
  "version": "1.1.0",
  "spec": "FRC_Design_System.md 1.1 (2026-08-22)",
  "classPrefix": "frc-",
  "root": "src/lib/design-system",
  "entry": "index.js",
  "authoring": "Built fresh from the specification. Never extracted from frc-app CSS. Migrating existing app surfaces onto these tokens is separate work.",
  "globalCssPaths": ["styles.css"],
  "tokens": {
    "entry": "styles.css",
    "order": [
      "tokens/fonts.css",
      "tokens/colors.css",
      "tokens/typography.css",
      "tokens/effects.css",
      "tokens/surfaces.css",
      "tokens/motion.css",
      "tokens/deck-motion.css",
      "tokens/image-slot.css",
      "tokens/data.css",
      "tokens/surface-components.css",
      "tokens/forms.css"
    ],
    "mirror": "tokens.js",
    "scope": "Root tokens are declared on .frc-deck and the three ground classes, never on :root.",
    "brand": { "--gold": "#FFE629", "--black": "#000000", "--space": "#53565F", "--ash": "#94989C", "--white": "#FFFFFF" },
    "partition": { "--alliance-red": "#ED1C24", "--alliance-blue": "#0066B3", "--warn": "#D98C3F", "--fault": "#B0503C", "--ok": "#6FA57B" },
    "program": { "--program": "#009CD7", "--program-frc": "#009CD7", "--program-ftc": "#F57E25", "--program-fll": "#ED1C24", "--program-fll-explore": "#00A651", "--program-fll-discover": "#662D91", "--program-fll-ink": "#231F20" },
    "season": { "--season": "#FFE629" },
    "groundAliases": [
      "--ground", "--bg0", "--bg1", "--bg2", "--plate", "--surface-viewport", "--edge", "--line", "--line-strong",
      "--fg", "--fg-dim", "--fg-structure", "--fg-hero", "--accent", "--accent-fg", "--accent-soft", "--rim",
      "--glow", "--glow-box", "--glow-strength", "--chrome-bg", "--chrome-fg", "--live",
      "--plate-rise", "--well-recess", "--panel-shadow", "--focus", "--selection-bg",
      "--tex-line", "--tex-fill", "--tex-accent", "--tex-hazard", "--tex-led", "--tex-bloom", "--tex-hi", "--tex-shade"
    ],
    "typeScale": { "--fs-hero": "160px", "--fs-display": "112px", "--fs-h1": "84px", "--fs-h2": "64px", "--fs-h3": "40px", "--fs-body": "28px", "--fs-body-sm": "24px", "--fs-label": "20px", "--fs-micro": "18px" },
    "radii": { "--radius-chip": "2px", "--radius-control": "3px", "--radius-panel": "4px" }
  },
  "themes": [
    { "name": "SQUADRON", "kind": "ground", "class": "frc-ground-squadron", "default": true, "scheme": "dark", "bg0": "#000000", "edge": "#000000", "accent": "#FFE629" },
    { "name": "FIELD", "kind": "ground", "class": "frc-ground-field", "scheme": "dark", "bg0": "#0E1013", "edge": "#05070A", "accent": "#FFE629" },
    { "name": "FIELD PAPER", "kind": "ground", "class": "frc-ground-paper", "scheme": "light", "bg0": "#E9E7E1", "edge": "#DCD9D1", "accent": "#7A6300", "note": "Techmen Gold is illegal here; accent is bronze ink, glow is zero." },
    { "name": "Internal", "kind": "audience", "class": "frc-audience-internal", "default": true },
    { "name": "External", "kind": "audience", "class": "frc-audience-external", "note": "Adds the FIRST logo zone to the footer rail; FirstName enforcement is mandatory." }
  ],
  "fonts": [
    { "token": "--font-display", "family": "Space Grotesk", "weights": [700], "source": "https://fonts.googleapis.com", "role": "Hero type, sheet titles, hero numerals, wordmark" },
    { "token": "--font-body", "family": "Space Grotesk", "weights": [400, 500], "source": "https://fonts.googleapis.com", "role": "All running copy" },
    { "token": "--font-mono", "family": "Space Mono", "weights": [400, 700], "source": "https://fonts.googleapis.com", "role": "Chrome, labels, metadata, codes, telemetry, timers" },
    { "token": "--font-first", "family": "Roboto", "weights": [400, 700], "italic": true, "source": "https://fonts.googleapis.com", "role": "FIRST-attributed blocks only. Never a fallback for Space Grotesk." }
  ],
  "components": [
    { "name": "Button", "group": "core", "sourcePath": "components/core/Button.jsx", "types": "components/core/Button.d.ts", "prompt": "components/core/Button.prompt.md", "class": "frc-button" },
    { "name": "Eyebrow", "group": "core", "sourcePath": "components/core/Eyebrow.jsx", "types": "components/core/Eyebrow.d.ts", "prompt": "components/core/Eyebrow.prompt.md", "class": "frc-eyebrow" },
    { "name": "Divider", "group": "core", "sourcePath": "components/core/Divider.jsx", "types": "components/core/Divider.d.ts", "prompt": "components/core/Divider.prompt.md", "class": "frc-divider" },
    { "name": "ChevronRail", "group": "core", "sourcePath": "components/core/ChevronRail.jsx", "types": "components/core/ChevronRail.d.ts", "prompt": "components/core/ChevronRail.prompt.md", "class": "frc-chevron-rail" },
    { "name": "TeamWordmark", "group": "core", "sourcePath": "components/core/TeamWordmark.jsx", "types": "components/core/TeamWordmark.d.ts", "prompt": "components/core/TeamWordmark.prompt.md", "class": "frc-wordmark" },
    { "name": "SealMark", "group": "brand", "sourcePath": "components/brand/SealMark.jsx", "types": "components/brand/SealMark.d.ts", "prompt": "components/brand/SealMark.prompt.md", "class": "frc-seal", "assets": ["assets/team/5669-Seal.svg"] },
    { "name": "MarkGlyph", "group": "brand", "sourcePath": "components/brand/MarkGlyph.jsx", "types": "components/brand/MarkGlyph.d.ts", "prompt": "components/brand/MarkGlyph.prompt.md", "class": "frc-mark", "assets": ["assets/team/Mark-Gold.svg", "assets/team/Mark-White.svg", "assets/team/Mark-Black.svg"] },
    { "name": "Logotype", "group": "brand", "sourcePath": "components/brand/Logotype.jsx", "types": "components/brand/Logotype.d.ts", "prompt": "components/brand/Logotype.prompt.md", "class": "frc-logotype", "assets": ["assets/team/Type-Gold.svg", "assets/team/Type-White.svg", "assets/team/Type-Black.svg"] },
    { "name": "DeckFooter", "group": "brand", "sourcePath": "components/brand/DeckFooter.jsx", "types": "components/brand/DeckFooter.d.ts", "prompt": "components/brand/DeckFooter.prompt.md", "class": "frc-footer", "assets": ["assets/team/5669-Seal.svg", "assets/first/FIRST-Horizontal-Reverse.png"] },
    { "name": "ProgramLockup", "group": "brand", "sourcePath": "components/brand/ProgramLockup.jsx", "types": "components/brand/ProgramLockup.d.ts", "prompt": "components/brand/ProgramLockup.prompt.md", "class": "frc-program-lockup", "assets": ["assets/first/FRC-Icon-Horizontal-Reverse.png", "assets/first/FRC-Icon-Vertical-Reverse.png", "assets/first/FTC-Icon-Horizontal-Reverse.png", "assets/first/FTC-Icon-Vertical-Reverse.png", "assets/first/FLL-Horizontal-Reverse.png", "assets/first/FLL-Vertical-Reverse.png"] },
    { "name": "SeasonLockup", "group": "brand", "sourcePath": "components/brand/SeasonLockup.jsx", "types": "components/brand/SeasonLockup.d.ts", "prompt": "components/brand/SeasonLockup.prompt.md", "class": "frc-season-lockup", "assets": ["assets/season/season-lockup.png"] },
    { "name": "FirstName", "group": "brand", "sourcePath": "components/brand/FirstName.jsx", "types": "components/brand/FirstName.d.ts", "prompt": "components/brand/FirstName.prompt.md", "class": "frc-first", "exports": ["FirstName", "FirstNameScope", "useFirstNameScope", "classifyFirstName"] },
    { "name": "HudFrame", "group": "brand", "sourcePath": "components/brand/HudFrame.jsx", "types": "components/brand/HudFrame.d.ts", "prompt": "components/brand/HudFrame.prompt.md", "class": "frc-hud" },
    { "name": "PlatePanel", "group": "brand", "sourcePath": "components/brand/PlatePanel.jsx", "types": "components/brand/PlatePanel.d.ts", "prompt": "components/brand/PlatePanel.prompt.md", "class": "frc-plate-panel" },
    { "name": "StencilTitle", "group": "brand", "sourcePath": "components/brand/StencilTitle.jsx", "types": "components/brand/StencilTitle.d.ts", "prompt": "components/brand/StencilTitle.prompt.md", "class": "frc-stencil" },
    {"name": "Badge", "group": "data", "sourcePath": "components/data/Badge.jsx", "types": "components/data/Badge.d.ts", "prompt": "components/data/Badge.prompt.md", "class": "frc-badge"},
    {"name": "Chip", "group": "data", "sourcePath": "components/data/Chip.jsx", "types": "components/data/Chip.d.ts", "prompt": "components/data/Chip.prompt.md", "class": "frc-chip"},
    {"name": "Field", "group": "data", "sourcePath": "components/data/Field.jsx", "types": "components/data/Field.d.ts", "prompt": "components/data/Field.prompt.md", "class": "frc-field"},
    {"name": "StatBlock", "group": "data", "sourcePath": "components/data/StatBlock.jsx", "types": "components/data/StatBlock.d.ts", "prompt": "components/data/StatBlock.prompt.md", "class": "frc-stat"},
    {"name": "Readout", "group": "data", "sourcePath": "components/data/Readout.jsx", "types": "components/data/Readout.d.ts", "prompt": "components/data/Readout.prompt.md", "class": "frc-readout"},
    {"name": "SpecTable", "group": "data", "sourcePath": "components/data/SpecTable.jsx", "types": "components/data/SpecTable.d.ts", "prompt": "components/data/SpecTable.prompt.md", "class": "frc-spec", "sub": ["SpecRow"]},
    {"name": "FocusTable", "group": "data", "sourcePath": "components/data/FocusTable.jsx", "types": "components/data/FocusTable.d.ts", "prompt": "components/data/FocusTable.prompt.md", "class": "frc-focus", "sub": ["FocusRow"], "note": "Click dims siblings. Emphasis only, never reveal."},
    {"name": "BarChart", "group": "data", "sourcePath": "components/data/BarChart.jsx", "types": "components/data/BarChart.d.ts", "prompt": "components/data/BarChart.prompt.md", "class": "frc-bars", "sub": ["Bar"]},
    {"name": "GanttChart", "group": "data", "sourcePath": "components/data/GanttChart.jsx", "types": "components/data/GanttChart.d.ts", "prompt": "components/data/GanttChart.prompt.md", "class": "frc-gantt", "sub": ["GanttBar"]},
    {"name": "DecisionMatrix", "group": "data", "sourcePath": "components/data/DecisionMatrix.jsx", "types": "components/data/DecisionMatrix.d.ts", "prompt": "components/data/DecisionMatrix.prompt.md", "class": "frc-matrix", "note": "weights and scores stay array-only: structure, not copy."},
    {"name": "Timeline", "group": "data", "sourcePath": "components/data/Timeline.jsx", "types": "components/data/Timeline.d.ts", "prompt": "components/data/Timeline.prompt.md", "class": "frc-timeline", "sub": ["TimelineItem"]},
    {"name": "MatchClock", "group": "data", "sourcePath": "components/data/MatchClock.jsx", "types": "components/data/MatchClock.d.ts", "prompt": "components/data/MatchClock.prompt.md", "class": "frc-clock", "note": "0:20 auto then 2:20 teleop, M:SS, silent, full duration at rest. Copper at the warning threshold, RUST at zero - never alliance red."},
    {"name": "BuildCountdown", "group": "data", "sourcePath": "components/data/BuildCountdown.jsx", "types": "components/data/BuildCountdown.d.ts", "prompt": "components/data/BuildCountdown.prompt.md", "class": "frc-countdown"},
    {"name": "ScoutTable", "group": "data", "sourcePath": "components/data/ScoutTable.jsx", "types": "components/data/ScoutTable.d.ts", "prompt": "components/data/ScoutTable.prompt.md", "class": "frc-scout", "sub": ["ScoutRow"], "note": "May use --alliance-red / --alliance-blue, FIELD ground only."},
    {"name": "AllianceSplit", "group": "data", "sourcePath": "components/data/AllianceSplit.jsx", "types": "components/data/AllianceSplit.d.ts", "prompt": "components/data/AllianceSplit.prompt.md", "class": "frc-alliance", "note": "May use --alliance-red / --alliance-blue, FIELD ground only."},
    {"name": "SubteamBadge", "group": "data", "sourcePath": "components/data/SubteamBadge.jsx", "types": "components/data/SubteamBadge.d.ts", "prompt": "components/data/SubteamBadge.prompt.md", "class": "frc-subteam", "note": "Reads the app subteam vocabulary from src/subteams.js. No per-value color map."},
    {"name": "Card", "group": "surfaces", "sourcePath": "components/surfaces/Card.jsx", "types": "components/surfaces/Card.d.ts", "prompt": "components/surfaces/Card.prompt.md", "class": "frc-card"},
    {"name": "Callout", "group": "surfaces", "sourcePath": "components/surfaces/Callout.jsx", "types": "components/surfaces/Callout.d.ts", "prompt": "components/surfaces/Callout.prompt.md", "class": "frc-callout"},
    {"name": "SafetyNote", "group": "surfaces", "sourcePath": "components/surfaces/SafetyNote.jsx", "types": "components/surfaces/SafetyNote.d.ts", "prompt": "components/surfaces/SafetyNote.prompt.md", "class": "frc-safety", "note": "Copper shop-hazard note. A distinct component, not a Callout tone, so a safety scan is a glance."},
    {"name": "ImageFrame", "group": "surfaces", "sourcePath": "components/surfaces/ImageFrame.jsx", "types": "components/surfaces/ImageFrame.d.ts", "prompt": "components/surfaces/ImageFrame.prompt.md", "class": "frc-frame", "note": "Image treatment 1: opaque, edge to edge. Backplate reads --surface-viewport. bleed drops the rim and brackets and throws on a screenshot."},
    {"name": "Cutout", "group": "surfaces", "sourcePath": "components/surfaces/Cutout.jsx", "types": "components/surfaces/Cutout.d.ts", "prompt": "components/surfaces/Cutout.prompt.md", "class": "frc-cutout", "note": "Image treatment 3: alpha channel. No backplate, no brackets; grading is a filter chain on the subject. fit is always contain."},
    {"name": "StepCard", "group": "surfaces", "sourcePath": "components/surfaces/StepCard.jsx", "types": "components/surfaces/StepCard.d.ts", "prompt": "components/surfaces/StepCard.prompt.md", "class": "frc-steps", "sub": ["Step"]},
    {"name": "ProcessPipeline", "group": "surfaces", "sourcePath": "components/surfaces/ProcessPipeline.jsx", "types": "components/surfaces/ProcessPipeline.d.ts", "prompt": "components/surfaces/ProcessPipeline.prompt.md", "class": "frc-pipeline", "sub": ["PipelineStep"]},
    {"name": "CompareSplit", "group": "surfaces", "sourcePath": "components/surfaces/CompareSplit.jsx", "types": "components/surfaces/CompareSplit.d.ts", "prompt": "components/surfaces/CompareSplit.prompt.md", "class": "frc-compare", "sub": ["CompareRow"]},
    {"name": "SampleGrid", "group": "surfaces", "sourcePath": "components/surfaces/SampleGrid.jsx", "types": "components/surfaces/SampleGrid.d.ts", "prompt": "components/surfaces/SampleGrid.prompt.md", "class": "frc-samples", "sub": ["Sample"]},
    {"name": "JumpGrid", "group": "surfaces", "sourcePath": "components/surfaces/JumpGrid.jsx", "types": "components/surfaces/JumpGrid.d.ts", "prompt": "components/surfaces/JumpGrid.prompt.md", "class": "frc-jumps", "sub": ["JumpCard"]},
    {"name": "CalloutDrawing", "group": "surfaces", "sourcePath": "components/surfaces/CalloutDrawing.jsx", "types": "components/surfaces/CalloutDrawing.d.ts", "prompt": "components/surfaces/CalloutDrawing.prompt.md", "class": "frc-drawing", "sub": ["CalloutPin"], "note": "Every pin label is drawn at rest; a click raises it."},
    {"name": "QuoteBlock", "group": "surfaces", "sourcePath": "components/surfaces/QuoteBlock.jsx", "types": "components/surfaces/QuoteBlock.d.ts", "prompt": "components/surfaces/QuoteBlock.prompt.md", "class": "frc-quote"},
    {"name": "RoleCard", "group": "surfaces", "sourcePath": "components/surfaces/RoleCard.jsx", "types": "components/surfaces/RoleCard.d.ts", "prompt": "components/surfaces/RoleCard.prompt.md", "class": "frc-role", "note": "Member with subteams and certifications, shaped like the app skills model. Props and children only; never queries."},
    {"name": "PartCallout", "group": "surfaces", "sourcePath": "components/surfaces/PartCallout.jsx", "types": "components/surfaces/PartCallout.d.ts", "prompt": "components/surfaces/PartCallout.prompt.md", "class": "frc-part", "note": "COTS part: vendor, part number, price."},
    {"name": "FieldDiagram", "group": "surfaces", "sourcePath": "components/surfaces/FieldDiagram.jsx", "types": "components/surfaces/FieldDiagram.d.ts", "prompt": "components/surfaces/FieldDiagram.prompt.md", "class": "frc-field-diagram", "note": "Zone geometry stays an array. May use --alliance-red / --alliance-blue, FIELD ground only."},
    {"name": "SponsorWall", "group": "surfaces", "sourcePath": "components/surfaces/SponsorWall.jsx", "types": "components/surfaces/SponsorWall.d.ts", "prompt": "components/surfaces/SponsorWall.prompt.md", "class": "frc-sponsors", "sub": ["SponsorTier"], "note": "Every sponsor mark is a Cutout ground=\"none\"; SponsorTier throws on anything else."},
    {"name": "AwardPlate", "group": "surfaces", "sourcePath": "components/surfaces/AwardPlate.jsx", "types": "components/surfaces/AwardPlate.d.ts", "prompt": "components/surfaces/AwardPlate.prompt.md", "class": "frc-award"},
    {"name": "ResultBanner", "group": "surfaces", "sourcePath": "components/surfaces/ResultBanner.jsx", "types": "components/surfaces/ResultBanner.d.ts", "prompt": "components/surfaces/ResultBanner.prompt.md", "class": "frc-result"},
    {"name": "Input", "group": "forms", "sourcePath": "components/forms/Input.jsx", "types": "components/forms/Input.d.ts", "prompt": "components/forms/Input.prompt.md", "class": "frc-input"},
    {"name": "Select", "group": "forms", "sourcePath": "components/forms/Select.jsx", "types": "components/forms/Select.d.ts", "prompt": "components/forms/Select.prompt.md", "class": "frc-select"}
  ],
  "helpers": [
    { "name": "icons", "sourcePath": "components/core/icons.jsx", "note": "Lucide paths inlined as 24x24 stroked SVG on currentColor" },
    { "name": "AssetSlot", "sourcePath": "components/brand/AssetSlot.jsx", "note": "Internal. The marked empty slot every mark-bearing component renders until its asset lands." },
    { "name": "cx", "sourcePath": "components/cx.js" },
    { "name": "slots", "sourcePath": "components/slots.jsx", "note": "Child-slot helpers. Copy lives in children carrying a plain slot attribute, because a props array is not editable on the canvas." },
    { "name": "assets", "sourcePath": "assets.js", "note": "Expected asset paths, resolved URLs (null until supplied), minimum sizes." }
  ],
  "cards": [
    { "name": "Core components", "group": "Core", "path": "components/core/CoreDemoCard.jsx", "export": "CoreDemoCard", "viewport": { "width": 1920, "height": 1200 }, "subtitle": "Button, Eyebrow, Divider, ChevronRail, TeamWordmark" },
    { "name": "Brand components", "group": "Brand", "path": "components/brand/BrandDemoCard.jsx", "export": "BrandDemoCard", "viewport": { "width": 1920, "height": 2600 }, "subtitle": "Marks, footer rail, program and season lockups, FirstName, HudFrame, PlatePanel, StencilTitle" },
    { "name": "Data components", "group": "Data", "path": "components/data/DataDemoCard.jsx", "export": "DataDemoCard", "viewport": { "width": 1920, "height": 3600 }, "subtitle": "Badges, stats, tables, charts, matrix, timeline, clocks, alliance surfaces" },
    { "name": "Surface components", "group": "Surfaces", "path": "components/surfaces/SurfacesDemoCard.jsx", "export": "SurfacesDemoCard", "viewport": { "width": 1920, "height": 4200 }, "subtitle": "Cards, callouts, safety, image treatments, steps, comparisons, grids, drawings, sponsors, awards" },
    { "name": "Form controls", "group": "Forms", "path": "components/forms/FormsDemoCard.jsx", "export": "FormsDemoCard", "viewport": { "width": 1920, "height": 1200 }, "subtitle": "Input and Select on every ground" }
  ],
  "templates": [
    { "name": "Deck", "path": "templates/Deck.dc.html", "copied": true, "aspect": "4:3", "width": 1920, "height": 1440, "note": "The only file anyone copies. Stage, ground class, audience class, footer rail, one blank sheet, deck-stage script." }
  ],
  "startingPoints": [
    { "name": "Deck shell", "path": "templates/Deck.dc.html", "description": "Copy this. Set the ground and audience classes on the root, add sheets, reference everything else." }
  ],
  "specimen": {
    "route": "/_ds",
    "sourcePath": "specimen/SpecimenPage.jsx",
    "proofs": "specimen/proofs.js",
    "guard": "import.meta.env.DEV || import.meta.env.VITE_DS_SPECIMEN === 'true'; the route is not registered in production and renders a 404 element there",
    "mounts": "the real components, never a copy of their markup"
  },
  "audit": "scripts/design-system/ds-audit.mjs (npm run ds:audit)",
  "pending": {
    "groups": ["sheets"],
    "templates": ["templates/Specimen.dc.html"],
    "assets": [
      "assets/team/Mark-Gold.svg", "assets/team/Mark-White.svg", "assets/team/Mark-Black.svg",
      "assets/team/Type-Gold.svg", "assets/team/Type-White.svg", "assets/team/Type-Black.svg",
      "assets/team/5669-Seal.svg", "assets/team/Mark-Guides.svg", "assets/team/Type-Guides.svg",
      "assets/first/FIRST-Horizontal-Reverse.png", "assets/first/FIRST-Vertical-Reverse.png",
      "assets/first/FRC-Icon-Horizontal-Reverse.png", "assets/first/FRC-Icon-Vertical-Reverse.png",
      "assets/first/FTC-Icon-Horizontal-Reverse.png", "assets/first/FTC-Icon-Vertical-Reverse.png",
      "assets/first/FLL-Horizontal-Reverse.png", "assets/first/FLL-Vertical-Reverse.png",
      "assets/season/season-lockup.png"
    ]
  }
}

{
  "namespace": "FRC5669DesignSystem",
  "version": "1.1.0",
  "spec": "FRC_Design_System.md 1.1 (2026-08-22)",
  "classPrefix": "frc-",
  "root": "src/lib/design-system",
  "entry": "index.js",
  "authoring": "Built fresh from the specification. Never extracted from frc-app CSS. Migrating existing app surfaces onto these tokens is separate work.",
  "globalCssPaths": [
    "styles.css"
  ],
  "tokens": {
    "entry": "styles.css",
    "order": [
      "tokens/fonts.css",
      "tokens/colors.css",
      "tokens/typography.css",
      "tokens/effects.css",
      "tokens/surfaces.css",
      "tokens/motion.css",
      "tokens/deck-motion.css",
      "tokens/image-slot.css",
      "tokens/data.css",
      "tokens/surface-components.css",
      "tokens/forms.css",
      "tokens/sheets.css"
    ],
    "mirror": "tokens.js",
    "scope": "Root tokens are declared on .frc-deck and the three ground classes, never on :root. .frc-deck SHARES the SQUADRON block, so SQUADRON is the fail-safe default: a groundless deck root, or a sheet that omits its ground class, resolves the complete 36-alias set rather than resolving partially.",
    "brand": {
      "--gold": "#FFE629",
      "--black": "#000000",
      "--space": "#53565F",
      "--ash": "#94989C",
      "--white": "#FFFFFF"
    },
    "partition": {
      "--alliance-red": "#ED1C24",
      "--alliance-blue": "#0066B3",
      "--warn": "#D98C3F",
      "--fault": "#B0503C",
      "--ok": "#6FA57B"
    },
    "program": {
      "--program": "#009CD7",
      "--program-frc": "#009CD7",
      "--program-ftc": "#F57E25",
      "--program-fll": "#ED1C24",
      "--program-fll-explore": "#00A651",
      "--program-fll-discover": "#662D91",
      "--program-fll-ink": "#231F20"
    },
    "season": {
      "--season": "#FFE629"
    },
    "groundAliases": [
      "--ground",
      "--bg0",
      "--bg1",
      "--bg2",
      "--plate",
      "--surface-viewport",
      "--edge",
      "--line",
      "--line-strong",
      "--fg",
      "--fg-dim",
      "--fg-structure",
      "--fg-hero",
      "--accent",
      "--accent-fg",
      "--accent-soft",
      "--rim",
      "--glow",
      "--glow-box",
      "--glow-strength",
      "--chrome-bg",
      "--chrome-fg",
      "--live",
      "--plate-rise",
      "--well-recess",
      "--panel-shadow",
      "--focus",
      "--selection-bg",
      "--tex-line",
      "--tex-fill",
      "--tex-accent",
      "--tex-hazard",
      "--tex-led",
      "--tex-bloom",
      "--tex-hi",
      "--tex-shade"
    ],
    "typeScale": {
      "--fs-hero": "160px",
      "--fs-display": "112px",
      "--fs-h1": "84px",
      "--fs-h2": "64px",
      "--fs-h3": "40px",
      "--fs-body": "28px",
      "--fs-body-sm": "24px",
      "--fs-label": "20px",
      "--fs-micro": "18px"
    },
    "radii": {
      "--radius-chip": "2px",
      "--radius-control": "3px",
      "--radius-panel": "4px"
    }
  },
  "themes": [
    {
      "name": "SQUADRON",
      "kind": "ground",
      "class": "frc-ground-squadron",
      "default": true,
      "scheme": "dark",
      "bg0": "#000000",
      "edge": "#000000",
      "accent": "#FFE629"
    },
    {
      "name": "FIELD",
      "kind": "ground",
      "class": "frc-ground-field",
      "scheme": "dark",
      "bg0": "#0E1013",
      "edge": "#05070A",
      "accent": "#FFE629"
    },
    {
      "name": "FIELD PAPER",
      "kind": "ground",
      "class": "frc-ground-paper",
      "scheme": "light",
      "bg0": "#E9E7E1",
      "edge": "#DCD9D1",
      "accent": "#7A6300",
      "note": "Techmen Gold is illegal here; accent is bronze ink, glow is zero."
    },
    {
      "name": "Internal",
      "kind": "audience",
      "class": "frc-audience-internal",
      "default": true
    },
    {
      "name": "External",
      "kind": "audience",
      "class": "frc-audience-external",
      "note": "Adds the FIRST logo zone to the footer rail; FirstName enforcement is mandatory."
    }
  ],
  "fonts": [
    {
      "token": "--font-display",
      "family": "Space Grotesk",
      "weights": [
        700
      ],
      "source": "https://fonts.googleapis.com",
      "role": "Hero type, sheet titles, hero numerals, wordmark"
    },
    {
      "token": "--font-body",
      "family": "Space Grotesk",
      "weights": [
        400,
        500
      ],
      "source": "https://fonts.googleapis.com",
      "role": "All running copy"
    },
    {
      "token": "--font-mono",
      "family": "Space Mono",
      "weights": [
        400,
        700
      ],
      "source": "https://fonts.googleapis.com",
      "role": "Chrome, labels, metadata, codes, telemetry, timers"
    },
    {
      "token": "--font-first",
      "family": "Roboto",
      "weights": [
        400,
        700
      ],
      "italic": true,
      "source": "https://fonts.googleapis.com",
      "role": "FIRST-attributed blocks only. Never a fallback for Space Grotesk."
    }
  ],

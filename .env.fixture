# Tracked env for fixture mode (npm run dev:fixture = vite --mode fixture).
# Committed on purpose, and it holds NO credential of any kind.
#
# In fixture mode src/supabase.js is replaced by src/dev/fixture/client.js, an
# in-memory fake, so nothing ever talks to a Supabase project. These values
# exist only because two pages build URLs from VITE_SUPABASE_URL
# (ParentResponse's Edge Function fetch, ProfilePage's calendar feed link).
# The fixture client answers fetches to <this URL>/functions/v1/* itself; the
# .invalid top-level domain is reserved and never resolves, so anything else
# aimed at it fails locally instead of reaching a real host.
VITE_SUPABASE_URL=https://fixture.supabase.invalid
VITE_SUPABASE_ANON_KEY=fixture-placeholder-not-a-key
